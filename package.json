{
  "name": "n8n-nodes-quanticdata",
  "version": "0.2.1",
  "description": "n8n community node for the QuanticData API — scrape any page to clean Markdown, run structured SERP searches, map sites, audit SEO and run 74 ready-made collectors through residential proxies. Pay per successful call.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "quanticdata",
    "web-scraping",
    "serp",
    "scraper",
    "residential-proxies",
    "data-extraction"
  ],
  "license": "MIT",
  "homepage": "https://quanticdata.io",
  "author": {
    "name": "QuanticData",
    "email": "support@quanticdata.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quantumproxies/n8n-nodes-quanticdata.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp nodes/QuanticData/quanticdata.svg dist/nodes/QuanticData/",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/QuanticDataApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/QuanticData/QuanticData.node.js"
    ]
  },
  "engines": {
    "node": ">=20.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "n8n-workflow": "^1.70.0",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
